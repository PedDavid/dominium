  <circle cx="11" cy="11" r="8" />
</svg>
        <input type="search" name="q" placeholder="Search domains…" autocomplete="off" aria-label="Search domains"
               hx-get="/search" hx-trigger="input changed delay:150ms, search, palette-open" hx-target="#command-results">
      </header>
      <div id="command-results" role="menu" aria-orientation="vertical" data-empty="No domains found."></div>
    </div>
  </dialog>
