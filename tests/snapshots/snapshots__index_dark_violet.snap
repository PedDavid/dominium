  <main class="mx-auto max-w-6xl px-4 py-6">
    
<div class="flex flex-col gap-6">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Domains</h1>
    <p class="text-muted-foreground text-sm">Where each domain is registered, when it expires and what it costs.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="card stat">
      <section>
        <p class="stat-label">Domains</p>
        <p class="stat-value">8</p>
        <p class="stat-note">5 need attention</p>
      </section>
    </div>
    <div class="card stat">
      <section>
        <p class="stat-label">Next expiry</p>
        
        <p class="stat-value" title="2026-10-01">in 5d</p>
        <p class="stat-note"><a class="hover:underline" href="/domains/shop-demo.net">shop-demo.net</a></p>
        
      </section>
    </div>
    <div class="card stat">
      <section>
        <p class="stat-label">Renewals per year</p>
        <p class="stat-value">$144.86<span class="text-muted-foreground"> + </span>€16.90</p>
        <p class="stat-note">every domain priced</p>
      </section>
    </div>
  </div>

  
  
  <div class="alert" role="status">
    <svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle cx="12" cy="12" r="10" />
  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
  <path d="M12 17h.01" />
</svg>
    <h2>In Cloudflare but not in the inventory</h2>
    <section>
      <p>Declare it in Pulumi, or remove it from the account:</p>
      <p class="flex flex-wrap gap-1.5"><span class="badge" data-variant="outline">forgotten.xyz</span></p>
    </section>
  </div>
  

  <form id="filters" class="flex flex-col gap-3" hx-get="/" hx-target="#domains-table" hx-push-url="true"
        hx-trigger="input changed delay:250ms from:#q, change">
    <div id="state-chips" class="flex flex-wrap gap-2" role="group" aria-label="Filter by state">
  <label class="state-chip" data-active="true">
    <input type="radio" name="state" value="" class="sr-only" checked>
    All <span class="text-muted-foreground">8</span>
  </label>
  
  <label class="state-chip" data-state="expired" data-active="false">
    <input type="radio" name="state" value="expired" class="sr-only" >
    <span class="state-dot"></span>Expired <span class="text-muted-foreground">1</span>
  </label>
  
  <label class="state-chip" data-state="critical" data-active="false">
    <input type="radio" name="state" value="critical" class="sr-only" >
    <span class="state-dot"></span>Critical <span class="text-muted-foreground">1</span>
  </label>
  
  <label class="state-chip" data-state="warning" data-active="false">
    <input type="radio" name="state" value="warning" class="sr-only" >
    <span class="state-dot"></span>Due soon <span class="text-muted-foreground">1</span>
  </label>
  
  <label class="state-chip" data-state="unknown" data-active="false">
    <input type="radio" name="state" value="unknown" class="sr-only" >
    <span class="state-dot"></span>Unknown <span class="text-muted-foreground">1</span>
  </label>
  
  <label class="state-chip" data-state="ok" data-active="false">
    <input type="radio" name="state" value="ok" class="sr-only" >
    <span class="state-dot"></span>OK <span class="text-muted-foreground">4</span>
  </label>
  
</div>
    <div class="flex flex-wrap gap-2">
